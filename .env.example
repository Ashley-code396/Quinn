# Database
DATABASE_URL=

# Redis
REDIS_URL=

# Agent Memory (Redis Cloud)
AGENT_MEMORY_BASE_URL=
AGENT_MEMORY_STORE_ID=
AGENT_MEMORY_API_KEY=

# LLM (all defaults are free-tier: Groq free plan, Gemini free tier, OpenRouter :free)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-oss-120b:free

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USERS=
TELEGRAM_CHAT_ID=

# Tools
TAVILY_API_KEY=
RUNWAY_API_KEY=

# LinkedIn Integration (for Dermaqea company page)
# Requires BOTH scopes from the LinkedIn Developer Portal → your app → Auth → OAuth 2.0 scopes:
#   - w_organization_social  — publish posts as the organization (urn:li:organization)
#   - r_organization_social  — read posts and page analytics
# Generate a fresh token after enabling the scopes.
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_ORGANIZATION_URN=
# For LinkedIn DMs: your personal profile URN (urn:li:person:xxxxx). Requires Messaging API product.
LINKEDIN_PERSON_URN=

# Email (Resend)
# Sign up at https://resend.com → API Keys → create key with "Email sending" permission
RESEND_API_KEY=
EMAIL_FROM_ADDRESS=quinn@dermaqea.com

# LangSmith (optional)
LANGSMITH_TRACING=
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=
