# LinkedIn Integration (for Dermaqea company page)
# Requires w_organization_social scope to post as an organization (urn:li:organization).
# Generate from https://developer.linkedin.com → your app → Auth → OAuth 2.0 scopes
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_ORGANIZATION_URN=
# For LinkedIn DMs: your personal profile URN (urn:li:person:xxxxx). Requires Messaging API product.
LINKEDIN_PERSON_URN=

# Email (Resend)
# Sign up at https://resend.com → API Keys → create key with "Email sending" permission
RESEND_API_KEY=
EMAIL_FROM_ADDRESS=quinn@dermaqea.com

# LangSmith (optional)
LANGSMITH_TRACING=
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=
